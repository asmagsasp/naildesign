{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin.html"
    },
    {
      "source": "/s/:salon/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/s/:salon/admin/:path*",
      "destination": "/admin.html"
    },
    {
      "source": "/s/:salon",
      "destination": "/salon.html"
    },
    {
      "source": "/s/:salon/:path*",
      "destination": "/salon.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
