{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/s/:salon/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/s/:salon/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/s/:salon",
      "destination": "/index.html"
    },
    {
      "source": "/s/:salon/",
      "destination": "/index.html"
    },
    {
      "source": "/s/:path*",
      "destination": "/index.html"
    }
  ]
}
