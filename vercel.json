{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/admin/?$",
      "dest": "/admin.html"
    },
    {
      "src": "^/s/[^/]+/admin/?$",
      "dest": "/admin.html"
    },
    {
      "src": "^/s/[^/]+/?$",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
