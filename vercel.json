{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin(.*)",
      "destination": "/admin.html"
    },
    {
      "source": "/s/(.*)/admin(.*)",
      "destination": "/admin.html"
    },
    {
      "source": "/s/(.*)",
      "destination": "/index.html"
    }
  ]
}
